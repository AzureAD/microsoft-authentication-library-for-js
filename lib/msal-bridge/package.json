{
    "name": "@azure/msal-bridge",
    "version": "0.1.0",
    "private": false,
    "description": "Portable Nested App Authentication bridge for WKWebView and WebView2 hosts",
    "type": "module",
    "sideEffects": [
        "./dist/autoInstall.mjs",
        "./dist/msal-bridge.js"
    ],
    "main": "./dist/index.cjs",
    "module": "./dist/index.mjs",
    "browser": "./dist/msal-bridge.js",
    "types": "./types/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./types/index.d.ts",
                "default": "./dist/index.mjs"
            },
            "require": {
                "types": "./types/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./auto": {
            "types": "./types/autoInstall.d.ts",
            "import": "./dist/autoInstall.mjs"
        },
        "./browser": "./dist/msal-bridge.js",
        "./package.json": "./package.json"
    },
    "files": [
        "dist",
        "types",
        "src",
        "README.md"
    ],
    "scripts": {
        "clean": "node -e \"for(const dir of ['dist','types','temp'])require('node:fs').rmSync(dir,{recursive:true,force:true})\"",
        "build:modules": "rollup -c rollup.config.mjs",
        "build:types": "tsc -p tsconfig.json --emitDeclarationOnly && node scripts/declarations.cjs",
        "build": "npm run clean && npm run build:modules && npm run build:types",
        "check": "tsc -p tsconfig.json --noEmit",
        "test": "node --test test/*.test.cjs",
        "api:check": "api-extractor run --config api-extractor.json && api-extractor run --config api-extractor.auto.json",
        "api:update": "api-extractor run --local --config api-extractor.json && api-extractor run --local --config api-extractor.auto.json",
        "test:consumer": "node scripts/consumer.cjs",
        "prepack": "npm run lint && npm run format:check && npm run build && npm run check && npm test && npm run api:check && npm run test:consumer",
        "lint": "eslint --max-warnings 0 src test scripts rollup.config.mjs .eslintrc.cjs --ext .ts,.cjs,.mjs",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" \"*.json\" \"*.mjs\" .eslintrc.cjs README.md",
        "format:fix": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" \"*.json\" \"*.mjs\" .eslintrc.cjs README.md",
        "test:coverage": "node --experimental-test-coverage --test test/*.test.cjs"
    },
    "devDependencies": {
        "@microsoft/api-extractor": "^7.58.7",
        "@rollup/plugin-node-resolve": "15.3.1",
        "@rollup/plugin-typescript": "^11.1.6",
        "@typescript-eslint/eslint-plugin": "5.62.0",
        "@typescript-eslint/parser": "5.62.0",
        "eslint": "8.57.1",
        "prettier": "2.8.7",
        "rollup": "^4.22.4",
        "tslib": "^2.8.1",
        "typescript": "^4.9.5"
    },
    "engines": {
        "node": ">=20"
    },
    "author": {
        "name": "Microsoft",
        "email": "nugetaad@microsoft.com",
        "url": "https://www.microsoft.com"
    },
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/AzureAD/microsoft-authentication-library-for-js.git",
        "directory": "lib/msal-bridge"
    },
    "beachball": {
        "disallowedChangeTypes": [
            "major"
        ]
    }
}
