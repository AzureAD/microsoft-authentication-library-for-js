{
  "name": "client-credential",
  "version": "1.0.0",
  "description": "Client Credential Regression Test",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js | tee output.txt",
    "test": "npm run test:cache && npm run benchmark:cache:smoke",
    "benchmark:cache": "node cache-benchmark.js --mode full",
    "benchmark:cache:smoke": "node cache-benchmark.js --mode smoke",
    "test:cache": "node --test cache-workload.test.js",
    "build:install": "cd ../../../ && npm install --workspace=@azure/msal-common --workspace=@azure/msal-node --workspace=regression-tests/msal-node/client-credential",
    "build:all": "cd ../../../ && npm run build --workspace=@azure/msal-common --workspace=@azure/msal-node",
    "start:build": "npm run build:install && npm run build:all && npm install && npm start"
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@azure/msal-node": "file:../../../lib/msal-node",
    "benchmark": "^2.1.4"
  }
}
