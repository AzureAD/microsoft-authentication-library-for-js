{
  "compilerOptions": {
    "moduleResolution": "node",
    "module": "commonjs",
    "target": "ES2020",
    "lib": [
      "ES2021",
      "dom",
      "ES2021.Promise"
    ],
    "allowUnusedLabels": false,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "noImplicitAny": true,
    "downlevelIteration": true,
    "types": [
      "node",
      "jest"
    ],
    "outDir": "./dist",
    "strict": true,
    "skipLibCheck": true
  },
  "include": [
    "./app.ts",
    "./cliArgs.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "compileOnSave": false,
  "buildOnSave": false
}
