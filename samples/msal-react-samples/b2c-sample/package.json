{
    "name": "b2c-sample",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@azure/msal-browser": "^5.0.0",
        "@azure/msal-react": "^5.0.0",
        "@emotion/react": "^11.9.3",
        "@emotion/styled": "^11.9.3",
        "@mui/icons-material": "^5.8.4",
        "@mui/material": "^5.9.0",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-router-dom": "^6.7.0"
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@vitejs/plugin-react": "^4.3.3",
        "e2e-test-utils": "file:../../e2eTestUtils",
        "jest": "^29.5.0",
        "jest-junit": "^16.0.0",
        "ts-jest": "^29.4.11",
        "vite": "^6.4.3"
    },
    "scripts": {
        "start": "vite",
        "build": "vite build",
        "test:e2e": "jest",
        "build:package": "cd ../../../ && npm run build:all --workspace=lib/msal-react"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "jest-junit": {
        "suiteNameTemplate": "B2C Sample Tests",
        "outputDirectory": ".",
        "outputName": "test-results.xml"
    }
}