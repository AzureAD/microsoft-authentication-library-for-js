{
    "name": "react16-sample",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@azure/msal-browser": "^5.0.0",
        "@azure/msal-react": "^5.0.0",
        "@material-ui/core": "^4.12.4",
        "@material-ui/icons": "^4.11.3",
        "react": "^16.8.0",
        "react-dom": "^16.8.0",
