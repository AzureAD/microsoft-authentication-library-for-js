        "e2e-test-utils": "file:../../e2eTestUtils",
        "env-cmd": "^10.1.0",
        "jest": "^29.5.0",
        "jest-junit": "^16.0.0",
        "ts-jest": "^29.1.0",
        "vite": "^5.4.21"
    },
    "jest-junit": {
        "suiteNameTemplate": "React 16 Compat Tests",
        "outputDirectory": ".",
        "outputName": "test-results.xml"
