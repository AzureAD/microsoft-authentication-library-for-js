{
    "name": "typescript-sample",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "dependencies": {
        "@azure/msal-browser": "^5.0.0",
        "@azure/msal-react": "^5.0.0",
        "@emotion/react": "^11.10.5",
        "@emotion/styled": "^11.10.5",
        "@mui/icons-material": "^5.10.16",
        "@mui/material": "^5.10.17",
        "@types/node": "^16.18.10",
        "@types/react": "^19.1.3",
        "@types/react-dom": "^19.1.3",
        "@types/react-router-dom": "^5.1.7",
        "react": "^19.2.1",
        "react-dom": "^19.2.1",
        "react-router-dom": "^6.7.0",
        "typescript": "^4.9.4"
    },
    "scripts": {
        "start": "vite",
        "build": "tsc && vite build",
        "build:package": "cd ../../../ && npm run build:all --workspace=lib/msal-react",
        "test:e2e": "jest"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "devDependencies": {
        "@types/jest": "^29.5.0",
        "@vitejs/plugin-react": "^5.0.0",
        "e2e-test-utils": "file:../../e2eTestUtils",
        "jest": "^29.5.0",
        "jest-junit": "^16.0.0",
        "ts-jest": "^29.4.11",
        "vite": "^7.0.0"
    },
    "jest-junit": {
        "suiteNameTemplate": "TypeScript Sample Tests",
        "outputDirectory": ".",
        "outputName": "test-results.xml"
    }
}