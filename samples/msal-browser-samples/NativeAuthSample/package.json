{
  "name": "native-auth-e2e-test-app",
  "version": "1.1.0",
  "license": "MIT",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build:package": "cd ../../../lib/msal-browser && npm run build:all",
    "start:build": "npm run build:package && npm start",
    "test:e2e": "jest --runInBand --detectOpenHandles --verbose"
  },
  "dependencies": {
    "express": "^4.20.0",
    "yargs": "^17.7.2"
  },
  "devDependencies": {
    "@azure/msal-browser": "^4.0.0",
    "@types/express": "^4.17.3",
    "@types/jest": "^29.5.0",
    "e2e-test-utils": "file:../../e2eTestUtils",
    "jest": "^29.5.0",
    "jest-junit": "^16.0.0",
    "jose": "^2.0.7",
    "ts-jest": "^29.4.11",
    "typescript": "^4.9.5"
  },
  "jest-junit": {
    "suiteNameTemplate": "Native Auth Sample Tests",
    "outputDirectory": ".",
    "outputName": "test-results.xml"
  }
}
