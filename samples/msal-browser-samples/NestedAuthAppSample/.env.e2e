# Configuration used by the e2e pipeline (jest `__STARTCMD__` runs the sample
# with `env-cmd -f .env.e2e`). Kept separate from `.env` so manual testing and
# automated e2e runs can point at different app registrations if needed.
#
# These are the public broker test-app registrations (not secrets — client and
# tenant IDs are public identifiers, mirrored in `.env`). The host and nested
# apps are registered so the host can broker the nested app's tokens over the
# web NAA flow. The pipeline does not token-replace these values, so they must
# be real working registrations (as with every other sample's `.env.e2e`).
SKIP_PREFLIGHT_CHECK=true
BROWSER=none
VITE_HOST_CLIENT_ID=1170d177-31a3-43a2-834d-702308e83f6d
VITE_NESTED_CLIENT_ID=dd138a81-f5f8-4d9c-8d24-d7bdd6ecc58f
VITE_AUTHORITY=https://login.microsoftonline.com/c7cef333-42af-492c-afb0-21f74a661133
