# Configuration used by the e2e pipeline (jest `__STARTCMD__` runs the sample
# with `env-cmd -f .env.e2e`). Kept separate from `.env` so manual testing and
# automated e2e runs can point at different app registrations if needed.
SKIP_PREFLIGHT_CHECK=true
BROWSER=none
VITE_HOST_CLIENT_ID=Enter_the_Host_Application_Id_Here
VITE_NESTED_CLIENT_ID=Enter_the_Nested_Application_Id_Here
VITE_AUTHORITY=https://login.microsoftonline.com/Enter_the_Tenant_Info_Here

# Enables the Encrypted Authorize Response (EAR) combination tests in
# naa-basic.spec.ts. This only reaches the jest process when the run is wrapped
# with env-cmd (`npm run test:e2e:ear`); the bare `jest` the CI pipeline runs
# never loads this file into jest, so EAR stays skipped in CI.
NAA_EAR_E2E=true

# Optional EAR-enabled app registrations for the NAA + EAR tests. EAR requires a
# registration with EAR enabled; point these at one (they reach the sample
# servers, which load this file, and then the browser via Vite). When unset the
# standard host/nested registrations above are reused and must themselves have
# EAR enabled. Authority defaults to VITE_AUTHORITY.
# VITE_EAR_HOST_CLIENT_ID=Enter_the_EAR_Host_Application_Id_Here
# VITE_EAR_NESTED_CLIENT_ID=Enter_the_EAR_Nested_Application_Id_Here
# VITE_EAR_AUTHORITY=https://login.microsoftonline.com/Enter_the_Tenant_Info_Here
