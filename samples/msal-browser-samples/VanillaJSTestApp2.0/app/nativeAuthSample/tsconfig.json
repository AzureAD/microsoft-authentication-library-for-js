{
    "compilerOptions": {
        "target": "ES2015",
        "lib": [
            "DOM",
            "ES6"
        ],
        "allowJs": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "module": "ESNext",
        "moduleResolution": "node",
        "resolveJsonModule": true,
        "isolatedModules": true,
        "noEmit": false,
        "outDir": "./app",
        "rootDir": "./src",
        "declaration": true,
        "sourceMap": true
    },
    "include": [
        // "src/**/*"
    ],
    "exclude": [
        "node_modules",
        "app"
    ]
}