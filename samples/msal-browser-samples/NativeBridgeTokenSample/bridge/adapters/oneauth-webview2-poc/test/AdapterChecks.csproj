<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../NativeOneAuth.cs" Link="NativeOneAuth.cs" />
    <Compile Include="../../../../native/NativeBrokerExecutor.cs" Link="NativeBrokerExecutor.cs" />
    <Compile Include="../../../../native/BrokerSettings.cs" Link="BrokerSettings.cs" />
    <ProjectReference Include="../../../src/Identity.NativeBridge/Identity.NativeBridge.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(OneAuthAdapterRuntimeDirectory)' != ''">
    <Content Include="$(OneAuthAdapterRuntimeDirectory)/OneAuthWebView2Poc.dll" Link="OneAuthWebView2Poc.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>