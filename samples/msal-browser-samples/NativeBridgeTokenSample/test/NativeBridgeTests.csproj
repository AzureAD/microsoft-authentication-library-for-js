<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="../native/bridge/BridgeScript.cs;../native/bridge/IBridgeTokenExecutor.cs;../native/bridge/NativeExecutorBoundary.cs" Link="bridge/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../../../../lib/msal-bridge/dist/msal-bridge.js" LogicalName="Identity.NativeBridge.msal-bridge.js" />
  </ItemGroup>
</Project>